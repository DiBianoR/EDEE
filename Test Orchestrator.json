    {
      "parameters": {
        "jsCode": "return { json: $('Edit Fields').item.json };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1184,
        304
      ],
      "id": "96aca4dd-83e4-475c-afa9-a7bbb87b29aa",
      "name": "State Restore"
    },
    {
      "parameters": {
        "jsCode": "// =============================================================================\n// 📋 FETCH JOB SUMMARY — everything the row needs, in one uniform shape.\n//\n// Sits on BOTH outputs of \"Call 'EDEE-main'\" so the sheet never has to branch.\n// On the error output the incoming item carries n8n's own crash message in\n// `error`; it's forwarded here because the state manager cannot know about it —\n// a hard crash means nothing was ever POSTed to it.\n//\n// SOURCE PRECEDENCE is resolved server-side: /summary reads total_cost.json from\n// the bucket first and only falls back to the Firestore running total, and it\n// survives the doc's 7-day TTL. Nothing here re-derives that — we just report\n// which source won, via cost_source.\n//\n// The archive call is conditional, not routine: it fires only when no transcript\n// exists in the bucket, which is the hard-crash case. It is also safe to fire\n// blind — the endpoint no-ops and returns the authoritative URL if one exists —\n// so a failed summary lookup falling through to it costs nothing.\n//\n// ⚠️ A Code node does NOT inherit paired items. Without the pairedItem tag on the\n//    returned item, $('Edit Fields').item downstream throws \"Can't determine which\n//    item to use\" — which is why Job ID / row_number / Run Time depend on it.\n// =============================================================================\n\nconst STATE_MANAGER = 'https://ritel-state-manager-194521282716.us-south1.run.app';\n\nconst input = $input.first().json;\n\n// job_id rides on both branches — n8n's error item is the INPUT item plus `error`,\n// and that input came from State Restore. Edit Fields is the last-ditch fallback.\nconst jobId = input.job_id || $('Edit Fields').first().json.job_id;\n\n// n8n's crash message: a string in most versions, an object in some. Normalize.\nconst rawError = input.error;\nconst n8nError = typeof rawError === 'string'\n    ? rawError\n    : (rawError?.message || rawError?.description || (rawError ? JSON.stringify(rawError) : null));\n\nlet summary = {};\ntry {\n    summary = await this.helpers.httpRequest({\n        method: 'GET',\n        url: `${STATE_MANAGER}/summary/${jobId}`,\n        json: true,\n        timeout: 10000\n    });\n} catch (e) {\n    // Never block the row — write what we know locally even if the lookup fails.\n    summary = { artifacts: {}, _summary_error: e.message };\n}\n\nconst artifacts = summary.artifacts || {};\n\n// Archive ONLY when the bucket has no transcript at all. A completed or cleanly\n// failed run already wrote session_events.json, so this no-ops on those paths.\nif (!artifacts['session_events.json'] && !artifacts['session_events_incremental.json']) {\n    try {\n        const archived = await this.helpers.httpRequest({\n            method: 'POST',\n            url: `${STATE_MANAGER}/archive-incremental/${jobId}`,\n            json: true,\n            timeout: 30000\n        });\n        if (archived?.url) artifacts['session_events_incremental.json'] = { url: archived.url };\n    } catch (e) {\n        // 404 = the run died before a single event was recorded. Nothing to link.\n    }\n}\n\nconst url = (name) => artifacts[name]?.url || null;\n\n// latest.png is just the most recent render — which column it belongs in depends on\n// how far the run got. Archive Scaffolding pins scaffolding.png at the END of Phase\n// 3, so its ABSENCE means the run died mid-scaffolding and latest.png is a matplotlib\n// render; its PRESENCE means the run reached the artist and latest.png is an img2img\n// attempt. This is why the fallback is asymmetric — it keeps latest.png in exactly\n// one column instead of duplicating it across both.\nconst scaffoldingUrl = url('scaffolding.png');\nconst finalUrl       = url('final_illustration.png');\nconst latestUrl      = url('latest.png');\n\n// Pass the whole incoming item through, then layer on what we learned. Two reasons:\n// nothing the workflow returned is silently dropped, and every derived field falls\n// back to the input — so if the state manager is unreachable, the row degrades to\n// what Send Final Broadcast returned instead of writing nulls over good values.\n// session_events is dropped: it's the full transcript, and the row links to it.\n// `??` not `||` throughout, so a legitimate 0 cost or empty string isn't discarded.\nconst { session_events, ...passthrough } = input;\n\nreturn [{\n    json: {\n        ...passthrough,\n        job_id: jobId,\n        n8n_error: n8nError,\n        // Summary wins where both exist — it's the persisted truth, and on success\n        // it reports \"completed\" rather than the envelope's \"Workflow Complete\".\n        // status \"running\" means the doc never received a terminal status → hard\n        // crash. null means the doc is gone entirely (TTL expired, bucket-only job).\n        status:          summary.status          ?? passthrough.status          ?? null,\n        error_message:   summary.error_message   ?? passthrough.error_message   ?? null,\n        user_message:    summary.user_message    ?? passthrough.user_message    ?? null,\n        archival_report: summary.archival_report ?? passthrough.archival_report ?? null,\n        total_cost:      summary.total_cost      ?? passthrough.total_cost      ?? 0,\n        // \"session_events\" = finalized from the authoritative array;\n        // \"firestore_running_total\" = mid-run/crashed; \"session_events_incremental\"\n        // = clean failure. Tells you how much to trust total_cost.\n        cost_source:     summary.cost_source     ?? null,\n        turns:           summary.session_events_count ?? null,\n        scaffolding_url: scaffoldingUrl || latestUrl,\n        final_url:       finalUrl || (scaffoldingUrl ? latestUrl : null),\n        transcript_url:  url('session_events.json') || url('session_events_incremental.json'),\n        cost_url:        url('total_cost.json'),\n        summary   // raw response, including the full artifacts manifest\n    },\n    pairedItem: { item: 0 }   // keeps $('Edit Fields').item resolvable downstream\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
