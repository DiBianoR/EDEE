    {
      "parameters": {
        "jsCode": "const executionData = $input.first().json.execution;\nconst errorMessage = executionData?.error?.message || \"Unknown fatal pipeline error.\";\n\n// 1. Initialize fallback values\nlet recoveredData = {\n    job_id: \"UNKNOWN\",\n    original_query: \"[Could not recover original query due to early crash]\",\n    latest_description: \"[No description available]\",\n    history: new Array() \n};\n\n// 2. Safely deep-search the crash log to rescue our real payload\nfunction salvageData(obj) {\n    if (!obj || typeof obj !== 'object') return;\n    \n    if (obj.job_id && typeof obj.job_id === 'string' && recoveredData.job_id === \"UNKNOWN\") {\n        recoveredData.job_id = obj.job_id;\n    }\n    if (Array.isArray(obj.history) && obj.history.length > recoveredData.history.length) {\n        recoveredData.history = obj.history;\n    }\n    // Only overwrite our fallbacks if we find the real strings\n    if (obj.original_query && typeof obj.original_query === 'string' && recoveredData.original_query.startsWith(\"[\")) {\n        recoveredData.original_query = obj.original_query;\n    }\n    if (obj.latest_description && typeof obj.latest_description === 'string' && recoveredData.latest_description.startsWith(\"[\")) {\n        recoveredData.latest_description = obj.latest_description;\n    }\n    \n    // Dig deeper\n    Object.values(obj).forEach(salvageData);\n}\n\nsalvageData(executionData);\n\n// 3. Inject the crash as a standard history entry\nrecoveredData.history.push({\n    phase_id: \"SYSTEM\",\n    agent_id: \"n8n_engine\",\n    task_id: \"execution\",\n    task_instruction: \"Run pipeline nodes.\",\n    output: {\n        fatal_crash: true,\n        system_error_message: errorMessage\n    }\n});\n\n// 4. Output the normalized, crash-proof payload\nreturn {\n    json: recoveredData\n};"
      },
